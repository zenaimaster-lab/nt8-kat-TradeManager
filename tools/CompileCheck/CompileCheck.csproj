<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile gate for the NinjaScript indicator sources (all 14 .cs files).
    NT8 compiles these inside NinjaTrader with .NET Framework 4.8 Roslyn;
    this project reproduces that locally. Run:  dotnet build tools/CompileCheck
    Reference assemblies come from NuGet (no admin / no VS required).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\KatTradeManager.cs" />
    <Compile Include="..\..\src\KatTradeManagerUI.cs" />
    <Compile Include="..\..\src\KatTradeManager.HudDrag.cs" />
    <Compile Include="..\..\src\KatTradeManager.OrderOps.cs" />
    <Compile Include="..\..\src\KatTradeManager.Queue.cs" />
    <Compile Include="..\..\src\KatTradeManager.AtmMerge.cs" />
    <Compile Include="..\..\src\KatTradeManager.DailyRisk.cs" />
    <Compile Include="..\..\src\KatTradeManager.Properties.cs" />
    <Compile Include="..\..\src\KatTradeCalculator.cs" />
    <Compile Include="..\..\src\KatAtmXmlParser.cs" />
    <Compile Include="..\..\src\KatTradeManager.Discipline.cs" />
    <Compile Include="..\..\src\KatTradeManager.ProfileOps.cs" />
    <Compile Include="..\..\src\KatAtmTemplateService.cs" />
    <Compile Include="..\..\src\KatTradeManager.SwingOps.cs" />
    <Compile Include="..\..\src\KatTradeManager.AccountInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="NinjaTrader.Core">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NinjaTrader.Gui">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Gui.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Compiled NT8 built-ins (EMA etc.). CS0436 type-conflict warnings vs local sources are expected: source wins. -->
    <Reference Include="NinjaTrader.Custom">
      <HintPath>$(USERPROFILE)\Documents\NinjaTrader 8\bin\Custom\NinjaTrader.Custom.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
